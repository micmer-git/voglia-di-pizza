      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://micmer-git.github.io,https://voglia-di-pizza.pages.dev,http://localhost:4321,http://127.0.0.1:4321,http://localhost:4322,http://127.0.0.1:4322,http://localhost:4173,http://127.0.0.1:4173"
  }
}
